# LLM Provider for Mem0 extraction ('openai', 'gemini', 'ollama')
LLM_PROVIDER=openai

# LLM API Key (required if using OpenAI or Gemini)
OPENAI_API_KEY=your_api_key_here

# Optional: Local Ollama Embedding / LLM Configuration
# OLLAMA_BASE_URL=http://<PROXMOX_OLLAMA_IP>:11434
# OLLAMA_MODEL=bge-m3
